<?xml version="1.0" encoding="utf-8"?>
<!-- Plate · Water: the app's water card. Default size shows everything (numbers, bar, buttons);
     it can't be shrunk below that, and it's capped so it never stretches into an empty box. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_water_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/widget_water_preview"
    android:minWidth="290dp"
    android:minHeight="170dp"
    android:minResizeWidth="290dp"
    android:minResizeHeight="170dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
